---
import AppLayout from '../layouts/AppLayout.astro';
import { env } from 'cloudflare:workers';
import { createDb } from '@/lib/db';
import { employees, employeeRegistrationRequests, departments, roles } from '@/lib/db/schema';
import { getPermissions, getPrincipal } from '@/lib/auth/service';
import { count, eq } from 'drizzle-orm';
import { DashboardShell } from '../components/dashboard/DashboardShell';

export const prerender = false;

// Authenticated session check
const auth = Astro.locals.auth;
if (!auth || !auth.isAuthenticated) {
  return Astro.redirect('/');
}

const db = createDb(env.poc_operation_db);

let principal: any = null;
let permissions: string[] = [];

try {
  principal = await getPrincipal(db, auth);
  const permSet = await getPermissions(db, principal.id);
  permissions = Array.from(permSet);
  Astro.locals.principal = principal;
  Astro.locals.permissions = permissions;
} catch (err) {
  return Astro.redirect('/?reason=session-expired');
}

// Query live operational metrics concurrently from D1 database
let activeWorkforceCount = 0;
let pendingRegistrationsCount = 0;
let departmentsCount = 0;
let rolesCount = 0;

try {
  const [empRes, regRes, deptRes, rolesRes] = await Promise.all([
    db.select({ value: count() }).from(employees).where(eq(employees.isActive, true)),
    db.select({ value: count() }).from(employeeRegistrationRequests).where(eq(employeeRegistrationRequests.status, 'PENDING')),
    db.select({ value: count() }).from(departments).where(eq(departments.isActive, true)),
    db.select({ value: count() }).from(roles).where(eq(roles.isActive, true)),
  ]);
  activeWorkforceCount = empRes[0]?.value ?? 0;
  pendingRegistrationsCount = regRes[0]?.value ?? 0;
  departmentsCount = deptRes[0]?.value ?? 0;
  rolesCount = rolesRes[0]?.value ?? 0;
} catch (error) {
  console.warn('Dashboard D1 query fallback:', error);
}
---

<AppLayout title="Dashboard | POC.OPERATION">
  <DashboardShell
    client:load
    user={principal}
    permissions={permissions}
    initialCounts={{
      activeWorkforce: activeWorkforceCount,
      pendingRegistrations: pendingRegistrationsCount,
      departments: departmentsCount,
      roles: rolesCount,
    }}
  />
</AppLayout>
