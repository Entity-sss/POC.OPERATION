---
import AuthLayout from '../layouts/AuthLayout.astro';
import { LoginPage } from '../components/auth/LoginPage';

export const prerender = false;

// If user is already authenticated, redirect to /dashboard
if (Astro.locals.auth?.isAuthenticated) {
  return Astro.redirect('/dashboard');
}

const reason = Astro.url.searchParams.get('reason');
---

<AuthLayout title="Sign In | POC.OPERATION" description="Enterprise Authentication Gateway for Pinnacle Operations Center">
  <LoginPage client:load initialReason={reason} />
</AuthLayout>
